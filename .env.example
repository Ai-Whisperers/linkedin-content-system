# AI-Whisperers Content Generator Configuration
#
# IMPORTANT:
# - Copy this to .env and fill in your actual values
# - Never commit .env to version control
# - .env is already in .gitignore

# ============================================================================
# CONTENT GENERATION (Required)
# ============================================================================

# Anthropic API Key for Claude content generation
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ============================================================================
# N8N AUTOMATION (Optional - for MCP automation)
# ============================================================================

# n8n instance URL
N8N_BASE_URL=http://localhost:5678

# n8n API Key
# Get your key from: n8n Settings → API → Create API Key
N8N_API_KEY=

# Content directory (auto-detected if not specified)
CONTENT_DIR=C:\Users\kyrian\Documents\contentCreator

# ============================================================================
# TESTING (Optional - for E2E tests)
# ============================================================================

# Gamma.app test credentials
GAMMA_TEST_EMAIL=
GAMMA_TEST_PASSWORD=

# Test configuration
HEADLESS=true
SLOW_MO=300
TEST_TIMEOUT=120000
