# n8n MCP Server Configuration

# n8n Instance URL (for API calls)
N8N_BASE_URL=http://localhost:5678

# n8n Webhook URL (for triggering workflows)
# Use this if webhooks are on a different URL (e.g., production webhooks)
# If not specified, defaults to N8N_BASE_URL
N8N_WEBHOOK_URL=http://localhost:5678

# n8n API Key (get from Settings > API in n8n)
N8N_API_KEY=your_n8n_api_key_here

# Content Directory (where generated posts are stored)
CONTENT_DIR=C:\Users\kyrian\Documents\contentCreator

# Webhook Configuration Notes:
# - Daily workflow webhook: {N8N_WEBHOOK_URL}/webhook/content-generator
# - LinkedIn workflow webhook: {N8N_WEBHOOK_URL}/webhook/content-generator-linkedin
# - Make sure workflows are ACTIVE in n8n for webhooks to work
# - Webhooks work with n8n version 1.118.2 (execute endpoint requires newer version)
