# E2E Test Environment Configuration
#
# IMPORTANT:
# 1. Copy this file to .env.test
# 2. Fill in your actual Gamma.app credentials
# 3. NEVER commit .env.test to version control
# 4. Add .env.test to .gitignore

# ============================================================================
# GAMMA.APP CREDENTIALS (REQUIRED)
# ============================================================================

# Your Gamma.app email address
GAMMA_TEST_EMAIL=your.email@example.com

# Your Gamma.app password
GAMMA_TEST_PASSWORD=your_password_here

# ============================================================================
# TEST CONFIGURATION (OPTIONAL)
# ============================================================================

# Run tests in headless mode (true for CI/CD, false for local debugging)
# Default: true in CI, false locally
HEADLESS=true

# Slow down automation for visibility (milliseconds)
# Default: 300
# Recommended: 0 for CI, 500-1000 for local debugging
SLOW_MO=300

# Test timeout in milliseconds
# Default: 120000 (2 minutes per test)
TEST_TIMEOUT=120000

# Maximum retries for flaky operations
# Default: 3
MAX_RETRIES=3

# ============================================================================
# SCREENSHOT CONFIGURATION (OPTIONAL)
# ============================================================================

# Directory for test screenshots
# Default: tests/e2e/screenshots
SCREENSHOTS_DIR=tests/e2e/screenshots

# Save screenshots on test failure
# Default: true
SCREENSHOT_ON_FAILURE=true

# Save screenshots for all steps (warning: generates many files)
# Default: false
SCREENSHOT_ALL_STEPS=false

# ============================================================================
# SESSION MANAGEMENT (OPTIONAL)
# ============================================================================

# Enable session persistence (faster test execution)
# Default: true
PERSIST_SESSION=true

# Session expiration time in hours
# Default: 24
SESSION_EXPIRY_HOURS=24

# ============================================================================
# CI/CD CONFIGURATION (OPTIONAL)
# ============================================================================

# Set to 'true' when running in CI environment
# This enables headless mode and adjusts timeouts
# Default: false
CI=false

# ============================================================================
# LOGGING & DEBUGGING (OPTIONAL)
# ============================================================================

# Enable verbose logging
# Default: false
VERBOSE=false

# Enable Playwright debug mode
# Default: false (set to 'true' to see all Playwright operations)
DEBUG=false

# Log level: error, warn, info, debug
# Default: info
LOG_LEVEL=info

# ============================================================================
# CLEANUP CONFIGURATION (OPTIONAL)
# ============================================================================

# Automatically delete test presentations after tests
# Default: true
AUTO_CLEANUP=true

# Keep presentations on test failure (for debugging)
# Default: true
KEEP_ON_FAILURE=true

# ============================================================================
# BROWSER CONFIGURATION (OPTIONAL)
# ============================================================================

# Browser to use: chromium, firefox, webkit
# Default: chromium (most stable for Gamma.app)
BROWSER=chromium

# Viewport width
# Default: 1920
VIEWPORT_WIDTH=1920

# Viewport height
# Default: 1080
VIEWPORT_HEIGHT=1080

# ============================================================================
# NETWORK CONFIGURATION (OPTIONAL)
# ============================================================================

# Navigation timeout in milliseconds
# Default: 30000 (30 seconds)
NAVIGATION_TIMEOUT=30000

# Network idle timeout in milliseconds
# Default: 5000 (5 seconds)
NETWORK_IDLE_TIMEOUT=5000

# ============================================================================
# FEATURE FLAGS (OPTIONAL)
# ============================================================================

# Enable visual regression testing
# Default: false (requires baseline screenshots)
ENABLE_VISUAL_REGRESSION=false

# Enable performance monitoring
# Default: false
ENABLE_PERFORMANCE_MONITORING=false

# Enable test recording (video)
# Default: false (warning: generates large files)
ENABLE_RECORDING=false

# ============================================================================
# GAMMA.APP SPECIFIC (OPTIONAL)
# ============================================================================

# Default theme to use for test presentations
# Options: Professional, Modern, Minimalist, etc.
# Default: Professional
DEFAULT_THEME=Professional

# Default export format
# Options: PDF, PNG, PPTX
# Default: PDF
DEFAULT_EXPORT_FORMAT=PDF

# ============================================================================
# NOTES
# ============================================================================

# To use this file:
# 1. cp .env.test.template .env.test
# 2. Edit .env.test with your actual values
# 3. Run tests: npm run test:e2e
#
# For debugging:
# npm run test:e2e:headed    (shows browser)
# npm run test:e2e:debug     (slow motion + verbose)
#
# For CI/CD:
# Set environment variables directly in CI configuration
# OR
# Use secure secrets management to populate .env.test
