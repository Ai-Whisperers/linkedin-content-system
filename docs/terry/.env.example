# ============================================
# TERRY AI IT AGENT - ENVIRONMENT CONFIGURATION
# ============================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. NEVER commit .env to Git (already in .gitignore)
# ============================================

# ============================================
# n8n Core Configuration
# ============================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Basic Authentication for n8n UI
# IMPORTANT: Change the password to something secure!
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=aiwhisperers
N8N_BASIC_AUTH_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# ============================================
# Database Configuration
# ============================================
# SQLite (recommended for local development)
DB_TYPE=sqlite

# PostgreSQL (recommended for production/cloud)
# Uncomment and configure if using PostgreSQL:
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=postgres
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=your_secure_postgres_password

# ============================================
# GitHub API
# ============================================
# Get token from: https://github.com/settings/tokens
# Required scopes: repo, workflow, admin:org, read:user
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_ORG=Ai-Whisperers

# ============================================
# OpenAI API
# ============================================
# Get from: https://platform.openai.com/api-keys
# Ensure you have GPT-4 access enabled
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# ============================================
# Email Configuration (Gmail Example)
# ============================================
# For Gmail: Use app-specific password (not your regular password)
# Enable 2FA first: https://myaccount.google.com/security
# Create app password: https://myaccount.google.com/apppasswords

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-gmail-16-char-app-password
EMAIL_FROM=terry@ai-whisperers.com
EMAIL_TO=your-email@gmail.com

# Alternative: SendGrid (recommended for production)
# EMAIL_SMTP_HOST=smtp.sendgrid.net
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_USER=apikey
# EMAIL_SMTP_PASSWORD=SG.your_sendgrid_api_key_here

# ============================================
# WhatsApp Business API (Optional)
# ============================================
# Setup guide: https://developers.facebook.com/docs/whatsapp/cloud-api
# Leave commented out if not using WhatsApp

# WHATSAPP_API_URL=https://graph.facebook.com/v18.0
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_ACCESS_TOKEN=EAAyour_whatsapp_access_token
# WHATSAPP_RECIPIENT=+595xxxxxxxxx

# ============================================
# LinkedIn API (Optional)
# ============================================
# Setup guide: https://www.linkedin.com/developers/apps
# Leave commented out if not using LinkedIn

# LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
# LINKEDIN_PERSON_URN=urn:li:person:your_person_id

# ============================================
# Vercel API (Optional)
# ============================================
# Get from: https://vercel.com/account/tokens
# Leave commented out if not using Vercel monitoring

# VERCEL_TOKEN=your_vercel_token
# VERCEL_TEAM_ID=team_xxxxxxxxxxxxx
# VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxx

# ============================================
# Monitoring Configuration
# ============================================
# How often to run checks (in seconds)
MONITOR_GITHUB_INTERVAL=21600      # 6 hours
MONITOR_WEBSITE_INTERVAL=900       # 15 minutes
MONITOR_DOCKER_INTERVAL=1800       # 30 minutes

# ============================================
# Alert Thresholds
# ============================================
# When to trigger alerts
ALERT_WEBSITE_RESPONSE_TIME=3000   # milliseconds
ALERT_CONTAINER_CPU_PERCENT=80     # percentage
ALERT_CONTAINER_MEMORY_PERCENT=80  # percentage

# ============================================
# Security
# ============================================
# Generate secure random strings for these
WEBHOOK_SECRET=CHANGE_THIS_TO_RANDOM_STRING
ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_STRING

# ============================================
# Optional: Webhook Tunnel (for development)
# ============================================
# Use ngrok or similar for receiving webhooks during development
# WEBHOOK_URL=https://your-domain.com
# N8N_WEBHOOK_TUNNEL_URL=https://your-ngrok-url.ngrok.io

# ============================================
# Advanced Configuration (Optional)
# ============================================
# Timezone for scheduling (default: America/Asuncion for Paraguay)
GENERIC_TIMEZONE=America/Asuncion

# Execution settings
EXECUTIONS_MODE=regular
EXECUTIONS_TIMEOUT=300
EXECUTIONS_TIMEOUT_MAX=3600

# Logging
N8N_LOG_LEVEL=info

# ============================================
# END OF CONFIGURATION
# ============================================
# After filling in your values:
# 1. Save this as .env (not .env.example)
# 2. Run: docker-compose up -d
# 3. Access: http://localhost:5678
# ============================================
