{
  "name": "GitHub Repository Health Check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "repositories",
              "value": "=[\"work-hours-automated-reports\", \"Company-Information\", \"agentic-schemas\", \"ai-whisperers-portfolio-website\", \"WPG-Amenities\", \"AI-Whisperers-Website\"]"
            },
            {
              "name": "org",
              "value": "Ai-Whisperers"
            }
          ]
        },
        "options": {}
      },
      "id": "set-repos",
      "name": "Set Repository List",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-repos",
      "name": "Loop Over Repositories",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.org}}/{{$json.repositories[$index]}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "id": "github-api-repo",
      "name": "Get Repository Info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [850, 300],
      "credentials": {
        "githubApi": {
          "id": "1",
          "name": "AI-Whisperers GitHub"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Analyze repository health\nconst repo = $input.first().json;\nconst now = new Date();\n\nlet healthScore = 100;\nlet problems = [];\n\n// Check last update\nconst lastUpdate = new Date(repo.updated_at);\nconst daysSinceUpdate = (now - lastUpdate) / (1000 * 60 * 60 * 24);\n\nif (daysSinceUpdate > 30) {\n  healthScore -= 20;\n  problems.push(`No updates in ${Math.floor(daysSinceUpdate)} days`);\n}\n\n// Check open issues\nif (repo.open_issues_count > 10) {\n  healthScore -= 15;\n  problems.push(`High open issues: ${repo.open_issues_count}`);\n}\n\n// Determine status\nlet status = 'healthy';\nlet priority = 'low';\n\nif (healthScore < 50) {\n  status = 'critical';\n  priority = 'high';\n} else if (healthScore < 75) {\n  status = 'warning';\n  priority = 'medium';\n}\n\nreturn {\n  json: {\n    repository: repo.name,
    health_score: healthScore,\n    status: status,\n    priority: priority,\n    problems: problems,\n    stats: {\n      stars: repo.stargazers_count,\n      forks: repo.forks_count,\n      open_issues: repo.open_issues_count\n    },\n    timestamp: now.toISOString()\n  }\n};"
      },
      "id": "analyze-health",
      "name": "Analyze Health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "operation": "notEqual",
              "value2": "healthy"
            }
          ]
        }
      },
      "id": "if-unhealthy",
      "name": "IF Unhealthy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "resource": "send",
        "operation": "sendEmail",
        "fromEmail": "terry@ai-whisperers.com",
        "toEmail": "alerts@ai-whisperers.com",
        "subject": "=⚠️ GitHub Health Alert: {{$json.repository}}",
        "emailFormat": "html",
        "message": "=<h2>Repository Health Alert</h2><p><strong>Repository:</strong> {{$json.repository}}</p><p><strong>Health Score:</strong> {{$json.health_score}}/100</p><p><strong>Status:</strong> {{$json.status}}</p><h3>Problems:</h3><ul>{{$json.problems.map(p => '<li>' + p + '</li>').join('')}}</ul><p><a href='https://github.com/Ai-Whisperers/{{$json.repository}}'>View on GitHub</a></p>",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Alert Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1450, 200],
      "credentials": {
        "smtp": {
          "id": "2",
          "name": "Terry Email"
        }
      }
    }
  ],
  "connections": {
    "Every 6 Hours": {
      "main": [
        [
          {
            "node": "Set Repository List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Repository List": {
      "main": [
        [
          {
            "node": "Loop Over Repositories",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Over Repositories": {
      "main": [
        [
          {
            "node": "Get Repository Info",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Repository Info": {
      "main": [
        [
          {
            "node": "Analyze Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze Health": {
      "main": [
        [
          {
            "node": "IF Unhealthy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Unhealthy": {
      "main": [
        [
          {
            "node": "Send Alert Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "versionId": "1",
  "id": "1",
  "meta": {
    "instanceId": "terry-01"
  },
  "tags": [
    {
      "name": "monitoring"
    },
    {
      "name": "github"
    }
  ]
}

